# =============================================================================
#  SIRH+ - Plantilla de variables de entorno. Copiar a .env y completar.
#
#      cp .env.example .env
#
#  El .env real NUNCA se versiona. Ver .claude/rules/04-seguridad.md seccion 1.
#  Este archivo se mantiene al dia: es lo primero que lee quien monta el
#  entorno, y lo primero que un agente toma como descripcion vigente.
#
#  Alcance: fase 0. Lo que entra en fases posteriores esta al final, comentado,
#  con la fase en la que se activa.
#  Sin tildes a proposito: este archivo lo leen tambien systemd y el shell.
# =============================================================================


# --- Django ------------------------------------------------------------------

# Clave secreta. Una distinta por entorno, siempre. Generar con:
#   python -c "import secrets; print(secrets.token_hex(32))"
DJANGO_SECRET_KEY=cambia-esta-clave

# False en produccion, siempre. Sin excepcion.
# Con True se aceptan los cuatro avisos de "check --deploy" que estan
# declarados en CLAUDE.md, seccion "Postura sobre HTTPS y check --deploy".
DJANGO_DEBUG=True

# Lista separada por comas. Nunca "*".
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1


# --- Base propia de la aplicacion --------------------------------------------
# PostgreSQL 17. Es la unica conexion de DATABASES en la fase 0.
# El usuario es propio de la aplicacion y de permisos minimos: nunca el
# superusuario de PostgreSQL.

BD_NAME=sirh_plus
BD_USER=sirh_app
BD_PASSWORD=
BD_HOST=localhost
BD_PORT=5432


# --- Identidad y permisos - desviacion D4 ------------------------------------
# SIRH+ NO GESTIONA USUARIOS: no crea cuentas, no guarda contrasenas y no
# administra credenciales. Eso es del gestor de identidad centralizado, del que
# SIRH+ es la fuente de verdad de las personas.
#
# El gestor esta en construccion. Hasta que exista, la pantalla de ingreso no
# valida nada y NO se construye autenticacion local de ninguna clase: ni tabla
# de usuarios, ni contrasenas, ni nada provisional. Por eso aqui no hay ninguna
# variable de autenticacion. Las de 'identidad/' se agregan cuando ese modulo
# se escriba.
# Justificado en claude/02-plan-de-ejecucion-sirh-plus.md seccion 1.2 (D4) y en
# CLAUDE.md, "SIRH+ no gestiona usuarios".

# Si la verificacion de permisos bloquea o solo registra:
#   false   el decorador deja pasar y anota en el log cada verificacion que
#           habria fallado. Es el modo de desarrollo mientras no haya gestor.
#   true    bloquea de verdad y devuelve la pantalla propia de 403.
# Al menos UNA VEZ POR FASE se corre con true y se revisa el registro. Es la
# salvaguarda contra repetir la autorizacion cosmetica del sistema viejo.
PERMISOS_EXIGIR=false

# Codigo con el que SIRH+ queda registrada en la tabla 'aplicacion' de la base
# de identidad. Todavia no tiene efecto: la fila se crea cuando el gestor
# exista. Se deja escrito para que el valor no se invente ese dia.
CODIGO_APLICACION=sirh_plus


# --- Registro de eventos ------------------------------------------------------
# Sin LOGGING configurado los errores no quedan en ningun lado, y entonces
# mostrarselos al usuario se vuelve la unica forma de verlos - que es justo lo
# que 04-seguridad.md seccion 4 prohibe.

# DEBUG, INFO, WARNING, ERROR. En produccion: INFO.
LOG_NIVEL=INFO

# Ruta relativa al proyecto, o absoluta en el servidor. La carpeta debe existir
# y ser escribible por el usuario del servicio.
LOG_ARCHIVO=logs/app.log


# =============================================================================
#  Todavia no: lo que cada fase agrega aqui
#
#  Nada de esto se activa antes de su fase. Esta escrito para que el dia que
#  toque no haya que adivinar el nombre ni el formato de la variable.
#  El inventario completo de sistemas ajenos esta en docs/diseno.md seccion 4.
# =============================================================================


# --- Gestor de identidad - cuando exista (D4) ---------------------------------
# SIRH+ no se conecta a la BASE de identidad ni la modela: habla con el gestor
# por su API, en la capa identidad_api/. La relacion va de SIRH+ hacia el
# gestor: alta de persona -> crear identidad; retiro -> revocarla.
#
# Ese bloque se define el dia que se escriba el modulo identidad/. Va a
# necesitar la direccion del gestor, una credencial de servicio y un tiempo de
# espera corto, como cualquier sistema ajeno (04-seguridad.md seccion 3).
# No se escriben aqui los nombres hoy para no inventar un contrato que todavia
# no esta acordado.


# --- SIRH viejo - fase 2 ------------------------------------------------------
# MySQL, SOLO LECTURA, en su capa sirh_legacy_db/. Nunca en DATABASES.
# El usuario de conexion debe tener unicamente permiso de lectura, para que la
# regla no dependa solo de la disciplina.
#
# SIRH_LEGACY_HOST=
# SIRH_LEGACY_DATABASE=
# SIRH_LEGACY_USER=
# SIRH_LEGACY_PASSWORD=
#
# Los dos tiempos de espera, en segundos. Nunca en infinito, que es el valor
# por defecto de casi todos los drivers: una consulta sin limite bloquea un
# worker de Gunicorn hasta que el otro extremo responda. Ver 04 seccion 3.
# SIRH_LEGACY_TIMEOUT_CONEXION=10
# SIRH_LEGACY_TIMEOUT_CONSULTA=60


# --- Los demas sistemas ajenos ------------------------------------------------
# Cada uno agrega su bloque, con el mismo patron del anterior, en su fase:
#
#   glpi_api/          Fase 3   GLPI, escritura por API: creacion de usuario
#   biometricos_api/   Fase 6   dispositivos en la LAN, lectura de marcaciones
#   daruma_db/         Fase 14  MySQL de calidad, lectura de documentos
#   mant_db/           Fase 18  SQL Server de dotacion, lectura del catalogo
#
# Lo que el estandar prohibe es escribir en la BASE de un sistema ajeno, no
# llamar a su API. A ninguna base ajena se le escribe.
